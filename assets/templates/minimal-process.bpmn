<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Defs_1" name="Model name"
             targetNamespace="http://example.com/bpmn/model-name">
  <process id="Process_1" name="Handle request" isExecutable="false">
    <startEvent id="Start_1" name="Request received"/>
    <userTask id="Task_1" name="Review request"/>
    <exclusiveGateway id="GW_1" name="Request complete?" default="Flow_no"/>
    <task id="Task_2" name="Approve request"/>
    <task id="Task_3" name="Ask requester for details"/>
    <endEvent id="End_1" name="Request approved"/>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_1"/>
    <sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="GW_1"/>
    <sequenceFlow id="Flow_yes" name="yes" sourceRef="GW_1" targetRef="Task_2"/>
    <sequenceFlow id="Flow_no" name="no" sourceRef="GW_1" targetRef="Task_3"/>
    <sequenceFlow id="Flow_3" sourceRef="Task_3" targetRef="Task_1"/>
    <sequenceFlow id="Flow_4" sourceRef="Task_2" targetRef="End_1"/>
  </process>
</definitions>
